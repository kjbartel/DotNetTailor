<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Tests need no XML docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- DotNetRepack.Testing is the shared test-support library, not a test project. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'DotNetRepack.Testing'">
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'DotNetRepack.Testing'">
    <PackageReference Include="xunit.v3" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)DotNetRepack.Testing\DotNetRepack.Testing.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
